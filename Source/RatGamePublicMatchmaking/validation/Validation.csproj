<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RatGameDir Condition="'$(RatGameDir)' == ''">$(MSBuildThisFileDirectory)..\..\..</RatGameDir>
    <CecilPath Condition="'$(CecilPath)' == ''">$(RatGameDir)\BepInEx\core\Mono.Cecil.dll</CecilPath>
  </PropertyGroup>
  <ItemGroup><Reference Include="Mono.Cecil"><HintPath>$(CecilPath)</HintPath><Private>true</Private></Reference></ItemGroup>
</Project>
